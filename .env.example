# Copy to `.env` for local development, or add each of these as a GitHub
# Actions Secret (Settings -> Secrets and variables -> Actions) in production.
# Never commit the filled-in `.env` — it is listed in .gitignore.
# Run `python scripts/check_setup.py` once you have filled these in.

# ---------------------------------------------------------------------------
# Facebook  (required)
# ---------------------------------------------------------------------------
# Numeric Page ID. Facebook Page -> About -> Page transparency, or Meta Business Suite.
FB_PAGE_ID=
# Page access token with pages_manage_posts + pages_read_engagement.
# Best: a System User token in Meta Business Suite (never expires).
# Otherwise: developers.facebook.com/tools/explorer -> exchange for a long-lived token.
FB_PAGE_ACCESS_TOKEN=
# App ID of your Meta app — developers.facebook.com/apps -> Settings -> Basic.
FB_APP_ID=
# App Secret from the same page. Only used to inspect the token via debug_token.
FB_APP_SECRET=
# Optional. Graph API version to call. Default: v21.0
FB_API_VERSION=

# ---------------------------------------------------------------------------
# AI  (GEMINI_API_KEY required with the default provider)
# ---------------------------------------------------------------------------
# Free Gemini key from aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Model used for the Urdu summary. Default: gemini-2.5-flash
GEMINI_MODEL=
# Optional. "gemini" (default, free tier) or "openai_compatible".
AI_PROVIDER=
# The three below are only read when AI_PROVIDER=openai_compatible (Groq, OpenRouter, ...).
# Optional. Base URL of the OpenAI-compatible API, e.g. https://api.groq.com/openai/v1
AI_BASE_URL=
# Optional. API key for that provider.
AI_API_KEY=
# Optional. Model name for that provider, e.g. llama-3.3-70b-versatile
AI_MODEL=

# ---------------------------------------------------------------------------
# Telegram  (required — this is the approval inbox)
# ---------------------------------------------------------------------------
# Bot token from @BotFather ("/newbot").
TELEGRAM_BOT_TOKEN=
# Your chat ID: message the bot once, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# Behaviour  (all optional)
# ---------------------------------------------------------------------------
# Optional. true = publish without waiting for the Telegram approve button. Default: false
AUTO_APPROVE=
# Optional. true = run the whole pipeline but send nothing anywhere. Default: false
DRY_RUN=
# Optional. Hours a pending post waits for approval before it expires. Default: 12
APPROVAL_TIMEOUT_HOURS=
# Optional. IANA timezone used for display and scheduling text. Default: Asia/Karachi
TIMEZONE=

# ---------------------------------------------------------------------------
# Branding  (all optional — these change the look of the image card)
# ---------------------------------------------------------------------------
# Optional. Name printed on the card. Default: کرکٹ اپڈیٹس
BRAND_NAME=
# Optional. Handle/URL shown under the brand name, e.g. @yourpage. Default: empty
BRAND_HANDLE=
# Optional. Accent (highlight) colour as a hex code. Default: #F5C542
BRAND_ACCENT=
# Optional. Deep background colour as a hex code. Default: #04140E
BRAND_DEEP=
